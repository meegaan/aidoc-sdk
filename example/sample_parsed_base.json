{"meta":{"processor":{"aidoc_core":"1.0","extractor":{"name":"txt","version":"1.0"},"semantic_layers":[]},"source_hash":"6a5e7bc8a2ddcf8629e1bbc45348efc1c8c424497da2b719a4d863a78c7e44d6"},"sections":[{"blocks":[{"id":"0db07423e31a96b848cbf24b54ffe053a5ab1be2c761338c28584e9225ab6ffd","semantic":[],"text":"DATA SECURITY POLICY – SAMPLE DOCUMENT","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"91426c22c0c15512236baa0b28c1d7514a56d21505889bd855c29a9b6d7f5b06","semantic":[],"text":"1. Purpose","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"a046f28fdb0d470990c811b1917e1e3d9a393fb27e3ecf8f4f2e24b6e0ca72ac","semantic":[],"text":"This document describes the rules for handling confidential information within the organization.","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"c3fd92e7d4eab551e349f3a2a43734bce08377637dab11c91570008ccf83c792","semantic":[],"text":"2. Definition","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"64a499cbad67c2cc451bd37e907032ff68e71e8bbad8e448ff1bb282463e72c6","semantic":[],"text":"\"Confidential Information\" means any non-public data, including customer records, financial data, and internal business plans.","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"537b72e6996f539319d21c94020cb5781c08e2f4b4825a066ebd6365eaeb9232","semantic":[],"text":"3. Requirement","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"23a2911fa2bce46841cd21a20b4f6b2f63c84cd6122309ef908b426f671d7d2a","semantic":[],"text":"Employees must protect all Confidential Information from unauthorized disclosure.","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"2d94ea067305479cdf2f07cea0faf0072c61836d2f3ee9bb3a04f004077ec7aa","semantic":[],"text":"4. Prohibition","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"b2876eb010788e8ff3f41d0c56f709161e65ebb317c907e8ed293b69ea6032ba","semantic":[],"text":"Employees must not share Confidential Information with external parties without proper authorization.","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"6b9c37eb653872c22079febe10eee06dd7bfb4d424fe91b2d4846a4c906f1cf7","semantic":[],"text":"5. Instruction","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"410ee75584e52995ee64206a5e86d4fa01848320732fce05cb2f6b20d38bbb40","semantic":[],"text":"To access secure files, open the company portal and log in using your assigned credentials.","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"e4e6ebd5946023f545e679aedfdbe648b6c129d6f6b71b716d1046dd4edcd5dc","semantic":[],"text":"6. Condition","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"e007ebc7484eb62dbca7aed7b90eaf170507874d3b5752823ed14571bf3cf309","semantic":[],"text":"If an employee suspects that Confidential Information has been exposed, the employee must report the incident immediately.","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"b614f961faaaa1680d982525b9c433e7d32eff3bddc406d2ee1d22c2b5b908cb","semantic":[],"text":"7. Exception","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"cbd6a149467f8ba909d30518efee448627034d90edea9c2714d14a02720225df","semantic":[],"text":"Unless explicitly authorized by the compliance department, employees may not transmit Confidential Information via personal email.","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"e56679bd7cf066ebdc227397c782720d61106e8578de59d646eb086e7b0338a5","semantic":[],"text":"8. Reference","type":"paragraph"},{"id":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","semantic":[],"text":"","type":"paragraph"},{"id":"02d05ea294ba49e023551d5414c440af8f22bcb3ab0d4568e983abacbd033b78","semantic":[],"text":"For additional guidance, see Section 12 of the Information Security Handbook.","type":"paragraph"}],"id":"b0ac686e9dd8e012ace2f0e9624f1881bcc982e50d8ed38583e4339ffcb2b2ae","level":1,"title":"Document"}],"spec":"aidoc@1.0"}